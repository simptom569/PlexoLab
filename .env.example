# Пример настроек сервера. Скопируйте в .env и поправьте. Файл .env в git не попадает.

# Подключение к PostgreSQL (на сервере пользователь без прав суперпользователя)
DATABASE_URL=postgres://postgres:dev@localhost:5432/plexolab

# Секрет подписи токенов доступа, не короче 32 символов. Сгенерировать: openssl rand -hex 32
JWT_SECRET=замените-на-случайную-строку-не-короче-32-символов

# Адрес, который слушает сервер
BIND_ADDR=127.0.0.1:8080

# Папка данных: загруженные файлы лежат в DATA_DIR/files/<uuid>. Её же нужно копировать при резервном копировании.
DATA_DIR=./data

# Самый большой загружаемый файл, мегабайты (от 1 до 2048). Если не задано, 25.
# MAX_UPLOAD_MB=25
# Сколько обычных команд может создать один человек («Личное» не считается), по умолчанию 5
# MAX_TEAMS_PER_USER=5

# Почта для регистрации и «Забыли пароль?» (docs/REGISTRATION.md).
# Ключ API создаётся на resend.com (API Keys). Пока он пустой, почты нет: регистрации и сброса пароля по почте нет.
RESEND_API_KEY=
# Адрес отправителя. onboarding@resend.dev — тестовый адрес Resend: письма с него доходят только на e-mail, на который
# зарегистрирован аккаунт Resend. Когда подтвердите свой домен в Resend, замените на PlexoLab <noreply@ваш-домен>.
# Без ключа это поле ничего не включает.
MAIL_FROM="PlexoLab <onboarding@resend.dev>"
# Для разработки вместо настоящей отправки: письма пишутся файлами в эту папку (вместе с RESEND_API_KEY не задавать)
# MAIL_OUTBOX_DIR=./data/outbox
# Сколько писем с кодами сервер отправляет за час на все адреса вместе, по умолчанию 30
# MAIL_MAX_PER_HOUR=30

# Откуда клиенту разрешено ходить в API (CORS), через запятую. Если не задано, подходят адреса Tauri и Vite для разработки.
# CORS_ORIGINS=http://tauri.localhost,http://localhost:1420

# Отдавать схему OpenAPI по /api/v1/openapi.json. Для разработки true, в боевом режиме не включать.
# Типы для клиента берутся командой `server openapi`, сервер для этого не нужен.
EXPOSE_OPENAPI=true

# Уровень логов
RUST_LOG=info
