{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PlexoLab",
  "version": "1.0.0",
  "identifier": "com.simptom.plexolab",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PlexoLab",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1MENERUMwNTVFRDZGQUMKUldTc2IrMVZ3TjRNZFN6cHVhaS8yYmN1L0pFVHg1Q0V3dE5oZzk3SmRaRmdXb3RYWWVFUnA4T1MK",
      "endpoints": ["https://github.com/simptom569/PlexoLab/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
